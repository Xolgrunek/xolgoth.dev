<style>
    th, td {
        border: 1px solid #14AADC;
        border-radius: 10px;
        color: #F9E2FF;
        font-weight: bolder;
        text-shadow: 0 0 3px darkviolet, 0 0 5px blueviolet;
        
    }
    th {
        text-align: center;
        padding: 15px
    }
    td {
        text-align: center;
    }
    th, td {
        background-image: linear-gradient(to bottom, #BF7FD2, #14AADC, #3E4D96);
    }
    .centerTable {
        margin: 0px auto;
        width: 100%;
        
        
    }
</style>